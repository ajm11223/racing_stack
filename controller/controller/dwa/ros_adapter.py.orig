"""ROS-facing adapter shared by both controller-manager executables."""

from __future__ import annotations

import numpy as np

from geometry_msgs.msg import Point
from visualization_msgs.msg import Marker, MarkerArray

from .dwa import DWAConfig, DWAController, DWA_PARAM_MAP


class DWARosAdapter:
    """Own DWA parameters, scheduling, fail-safe handling, and RViz output."""

    def __init__(self, node) -> None:
        self.node = node
        defaults = DWAConfig()
        values = {
            field_name: node._get_param(param_name, getattr(defaults, field_name))
            for param_name, field_name in DWA_PARAM_MAP.items()
        }
        self.controller = DWAController(DWAConfig(**values))
        self.plan_rate_hz = float(node._get_param("dwa_plan_rate_hz", 20.0))
        self._last_plan_sec = None
        self.candidates_pub = node.create_publisher(
            MarkerArray, "/dwa_planner/candidates", 10,
        )
        self.selected_pub = node.create_publisher(
            Marker, "/dwa_planner/selected", 10,
        )
        self.goal_pub = node.create_publisher(
            Marker, "/dwa_planner/goal", 10,
        )

    def set_reference_path(self, x, y) -> None:
        self.controller.set_reference_path(x, y)

    def enter(self) -> None:
        self.controller.reset_history()
        self._last_plan_sec = None

    def update_parameter(self, name: str, value) -> bool:
        if name in DWA_PARAM_MAP:
            self.controller.update_config(**{DWA_PARAM_MAP[name]: value})
            return True
        if name == "dwa_plan_rate_hz":
            self.plan_rate_hz = max(1.0, float(value))
            return True
        return False

    def yaml_parameters(self) -> dict:
        params = {}
        for param_name, field_name in DWA_PARAM_MAP.items():
            if self.node.has_parameter(param_name):
                params[param_name] = self.node.get_parameter(param_name).value
            else:
                params[param_name] = getattr(self.controller.config, field_name)
        params["dwa_plan_rate_hz"] = float(self.plan_rate_hz)
        return params

    def cycle(self, scan, pose, speed_mps: float) -> tuple[float, float]:
        node = self.node
        if scan is None:
            node.get_logger().error(
                f"[{node.name}] DWAONLY has no /scan; stopping",
                throttle_duration_sec=0.5,
            )
            return 0.0, 0.0

        now_sec = node.get_clock().now().nanoseconds * 1.0e-9
        due = (
            self._last_plan_sec is None
            or now_sec - self._last_plan_sec >= 1.0 / max(self.plan_rate_hz, 1.0)
        )
        if due:
            try:
                command = self.controller.process(
                    np.asarray(pose, dtype=float).reshape(-1)[:3],
                    speed_mps,
                    scan.ranges,
                    scan.angle_min,
                    scan.angle_increment,
                )
            except (RuntimeError, TypeError, ValueError, FloatingPointError) as exc:
                node.get_logger().error(
                    f"[{node.name}] DWA planning failed; stopping: {exc}",
                    throttle_duration_sec=0.5,
                )
                self.controller.reset_history()
                return 0.0, 0.0
            self._last_plan_sec = now_sec
            self._publish(self.controller.last_result)
        else:
            command = self.controller.command_from_last()

        node.get_logger().warning(
            f"[{node.name}] DWAONLY!!!", throttle_duration_sec=0.5,
        )
        return command

    def _publish(self, result) -> None:
        if result is None:
            return
        stamp = self.node.get_clock().now().to_msg()
        markers = MarkerArray()
        clear = Marker()
        clear.header.frame_id = "map"
        clear.header.stamp = stamp
        clear.action = Marker.DELETEALL
        markers.markers.append(clear)

        for candidate in result.candidates:
            marker = Marker()
            marker.header.frame_id = "map"
            marker.header.stamp = stamp
            marker.ns = "dwa_candidates"
            marker.id = candidate.index
            marker.type = Marker.LINE_STRIP
            marker.action = Marker.ADD
            marker.scale.x = 0.012
            marker.color.a = 0.35
            marker.color.r = 1.0 if candidate.collision else 0.10
            marker.color.g = 0.15 if candidate.collision else 0.55
            marker.color.b = 0.10 if candidate.collision else 1.0
            marker.pose.orientation.w = 1.0
            marker.points = [
                Point(x=float(x), y=float(y), z=0.0)
                for x, y in zip(candidate.x, candidate.y)
            ]
            markers.markers.append(marker)
        self.candidates_pub.publish(markers)

        selected = Marker()
        selected.header.frame_id = "map"
        selected.header.stamp = stamp
        selected.ns = "dwa_selected"
        selected.id = 0
        selected.type = Marker.LINE_STRIP
        selected.action = Marker.ADD
        selected.scale.x = 0.045
        selected.color.a = 1.0
        selected.color.r = 1.0 if result.emergency else 0.0
        selected.color.g = 0.35 if result.emergency else 1.0
        selected.color.b = 0.0
        selected.pose.orientation.w = 1.0
        selected.points = [
            Point(x=float(x), y=float(y), z=0.02)
            for x, y in zip(result.selected.x, result.selected.y)
        ]
        self.selected_pub.publish(selected)

        goal = Marker()
        goal.header.frame_id = "map"
        goal.header.stamp = stamp
        goal.ns = "dwa_goal"
        goal.id = 0
        goal.type = Marker.SPHERE
        goal.action = Marker.ADD
        goal.scale.x = 0.15
        goal.scale.y = 0.15
        goal.scale.z = 0.15
        goal.color.a = 1.0
        goal.color.r = 1.0
        goal.color.g = 0.0
        goal.color.b = 1.0
        goal.pose.position.x = result.goal_x_m
        goal.pose.position.y = result.goal_y_m
        goal.pose.orientation.w = 1.0
        self.goal_pub.publish(goal)
