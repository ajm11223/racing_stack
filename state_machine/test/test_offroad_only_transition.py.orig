from types import SimpleNamespace

from state_machine.state_transitions import (
    FTGOnlyTransition,
    OffRoadOnlyTransition,
    TrailingTransition,
)
from state_machine.states_types import StateType


def test_offroad_direct_controller_has_priority_when_its_trigger_fires():
    state_machine = SimpleNamespace(
        cur_obstacles_in_interest=[object()],
        _check_close_to_raceline=lambda *args: True,
        _check_close_to_raceline_heading=lambda *args: True,
        _check_offroad=lambda: True,
        _check_ftg=lambda: True,
    )

    state, source = TrailingTransition(state_machine)

    assert state == StateType.OFFROADONLY
    assert source == StateType.OFFROADONLY


def test_ftg_remains_available_when_offroad_trigger_is_disabled():
    state_machine = SimpleNamespace(
        cur_obstacles_in_interest=[object()],
        _check_close_to_raceline=lambda *args: True,
        _check_close_to_raceline_heading=lambda *args: True,
        _check_offroad=lambda: False,
        _check_ftg=lambda: True,
    )

    state, source = TrailingTransition(state_machine)

    assert state == StateType.FTGONLY
    assert source == StateType.FTGONLY


def test_direct_controller_states_never_transition_to_overtake():
    cases = (
        (FTGOnlyTransition, "ftg_counter", StateType.FTGONLY),
        (OffRoadOnlyTransition, "offroad_counter", StateType.OFFROADONLY),
    )

    for transition, counter_name, expected_state in cases:
        state_machine = SimpleNamespace(
            cur_obstacles_in_interest=[object()],
            _check_close_to_raceline=lambda *args: False,
            _check_close_to_raceline_heading=lambda *args: False,
            _check_free_frenet=lambda *args: False,
            _check_latest_wpnts=lambda *args: False,
            _check_overtaking_mode=lambda: True,
            _check_static_overtaking_mode=lambda: True,
            cur_gb_wpnts=None,
            recovery_wpnts=None,
            cur_recovery_wpnts=None,
            overtake_entry_count=2,
            overtake_entry_ticks=3,
            gb_return_count=0,
            gb_return_ticks=3,
            offroad_ttl_count=0,
            offroad_ttl_count_threshold=80,
        )
        setattr(state_machine, counter_name, 0)

        state, source = transition(state_machine)

        assert state == expected_state
        assert source == expected_state
        assert state_machine.overtake_entry_count == 0


def test_offroad_holds_for_ttl_after_obstacle_disappears():
    state_machine = SimpleNamespace(
        cur_obstacles_in_interest=[],
        offroad_ttl_count=0,
        offroad_ttl_count_threshold=2,
    )

    assert OffRoadOnlyTransition(state_machine) == (
        StateType.OFFROADONLY,
        StateType.OFFROADONLY,
    )
    assert OffRoadOnlyTransition(state_machine) == (
        StateType.OFFROADONLY,
        StateType.OFFROADONLY,
    )
    assert state_machine.offroad_ttl_count == 2

    state_machine._check_close_to_raceline = lambda *args: True
    state_machine._check_close_to_raceline_heading = lambda *args: True
    state, source = OffRoadOnlyTransition(state_machine)

    assert state == StateType.GB_TRACK
    assert source == StateType.GB_TRACK
    assert state_machine.offroad_ttl_count == 0


def test_offroad_obstacle_redetection_restarts_ttl():
    state_machine = SimpleNamespace(
        cur_obstacles_in_interest=[object()],
        offroad_ttl_count=5,
        offroad_ttl_count_threshold=80,
        _check_close_to_raceline=lambda *args: False,
        _check_close_to_raceline_heading=lambda *args: False,
        _check_free_frenet=lambda *args: False,
        _check_latest_wpnts=lambda *args: False,
        cur_gb_wpnts=None,
        recovery_wpnts=None,
        cur_recovery_wpnts=None,
        overtake_entry_count=0,
        gb_return_count=0,
        gb_return_ticks=3,
        offroad_counter=0,
    )

    state, source = OffRoadOnlyTransition(state_machine)

    assert state == StateType.OFFROADONLY
    assert source == StateType.OFFROADONLY
    assert state_machine.offroad_ttl_count == 0
